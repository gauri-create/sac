# ── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string
PORT=5050
FLASK_DEBUG=0               # Set to 1 for hot-reload during development

# ── Camera ────────────────────────────────────────────────────────────────────
CAMERA_INDEX=0              # 0 = default webcam, 1+ = external/USB cameras

# ── Database backend ──────────────────────────────────────────────────────────
DB_BACKEND=sqlite           # "sqlite" or "mysql"
SQLITE_PATH=data/access_logs.db

# MySQL (only used when DB_BACKEND=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=secure_entry

# ── Face recognition tuning ───────────────────────────────────────────────────
# Lower = stricter matching (fewer false positives, may miss known faces)
# Higher = looser matching (catches more but may misidentify)
# CONFIDENCE_THRESHOLD=0.50  (default, override in recognition.py)
